---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Legal Notice — Eduardo Saldaña">
  <div class="min-h-screen section-container max-w-3xl mx-auto pt-32">
    <h1 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-12 flex items-center gap-4">
      <span class="text-accent">/</span> Legal Notice
    </h1>

    <div class="space-y-10 font-body text-subtext">

      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-maintext">Website owner</h2>
        <p>Eduardo Saldaña</p>
        <p>Zaragoza, Spain</p>
        <p><a href="mailto:esaldanaf@gmail.com" class="text-accent hover:underline">Contact</a></p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-maintext">Purpose</h2>
        <p>This website is a personal portfolio intended to showcase professional experience, technical projects and skills. It does not collect, store or process any personal data from visitors.</p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-maintext">Cookies</h2>
        <p>This website does not use cookies of any kind — neither own nor third-party. No tracking or analytics tools are active.</p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-maintext">Intellectual property</h2>
        <p>All content published on this website (texts, code, images) is authored by Eduardo Saldaña unless otherwise stated. Project source code is available under the respective licenses indicated in each repository.</p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-semibold text-maintext">Hosting</h2>
        <p>This website is hosted on GitHub Pages (GitHub, Inc., 88 Colin P Kelly Jr St, San Francisco, CA 94107, USA). GitHub's privacy policy applies to infrastructure-level data: <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener" class="text-accent hover:underline">GitHub Privacy Statement</a>.</p>
      </section>

      <div class="pt-8">
        <a href="/" class="text-accent hover:underline text-sm">← Back to portfolio</a>
      </div>

    </div>
  </div>
</Layout>