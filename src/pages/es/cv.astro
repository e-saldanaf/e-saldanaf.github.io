---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { useTranslations } from "@i18n/translations";

const t = useTranslations("es");
---

<Layout title={t("cv.title")} description={t("cv.description")}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-16">

        <!-- Header -->
        <section>
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-6">
            <img
              src="/avatar.jpg"
              alt="Eduardo Saldaña Fuertes"
              width="80"
              height="80"
              class="rounded-full w-20 h-20 object-cover ring-2 ring-black/10 dark:ring-white/20"
            />
            <div>
              <h1 class="font-semibold text-black dark:text-white mb-1">
                Eduardo Saldaña Fuertes
              </h1>
              <p class="text-sm text-gray-500 dark:text-gray-400">
                <Link href="https://www.linkedin.com/in/esaldanaf/" external>
                  Ingeniero de Datos · Power Platform App Maker
                </Link>
              </p>
            </div>
          </div>
        </section>

        <!-- Experiencia Laboral -->
        <section class="animate space-y-8">
          <h2 class="font-semibold text-black dark:text-white">
            {t("cv.experience")}
          </h2>

          <!-- G.team / Vueling -->
          <div class="space-y-2">
            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  Ingeniero de Datos — Vueling Airlines
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  G.team · Híbrido · Zaragoza, España
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500 text-nowrap">
                Abr 2023 – May 2026
              </span>
            </div>
            <ul class="space-y-1 text-sm list-disc list-outside ml-4">
              <li>
                Diseño y mantenimiento de la infraestructura de datos de Vueling, transformando
                datos operativos complejos en activos estratégicos bajo metodología Agile (Scrum).
              </li>
              <li>
                Construcción de pipelines de ingesta desde fuentes heterogéneas: PostgreSQL, SQL Server,
                Redshift, APIs REST, SharePoint y web scraping.
              </li>
              <li>
                Diseño de DAGs ETL/ELT parametrizados en Apache Airflow garantizando idempotencia
                y transiciones fluidas entre entornos.
              </li>
              <li>
                Implementación de logging estructurado y observabilidad mediante el stack
                Elasticsearch/Kibana para el control de salud de los pipelines.
              </li>
              <li>
                Migración del CI/CD de Jenkins a Azure DevOps, integrando la gestión de secretos
                con AWS Secrets Manager.
              </li>
              <li>
                Optimización de procesos de carga incremental y completa en AWS Redshift y
                PostgreSQL, usando Amazon S3 como data lake.
              </li>
            </ul>
            <div class="flex flex-wrap gap-2 pt-1">
              {[
                "Python", "Pandas", "Apache Airflow", "AWS Redshift",
                "Amazon S3", "Elasticsearch", "Kibana", "Azure DevOps",
                "Jenkins", "SQL Server", "REST APIs", "Scrum",
              ].map((skill) => (
                <span class="rounded-full border border-black/15 px-2 py-0.5 text-xs dark:border-white/20">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <hr class="border-black/10 dark:border-white/10" />

          <!-- SEGULA / Michelin -->
          <div class="space-y-2">
            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  Ingeniero Power Platform — Michelin CEMA
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  SEGULA Technologies · Presencial · Zaragoza, España
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500 text-nowrap">
                Sep 2022 – Mar 2023
              </span>
            </div>
            <ul class="space-y-1 text-sm list-disc list-outside ml-4">
              <li>
                Liderazgo técnico en proyectos de transformación digital y optimización de procesos
                en el Centro de Experiencias de Michelin (CEMA).
              </li>
              <li>
                Sustitución de formularios físicos por aplicaciones dinámicas con Power Apps
                y Microsoft Forms.
              </li>
              <li>
                Diseño de flujos operativos en Power Automate integrados con bases de datos
                en SharePoint Online.
              </li>
              <li>
                Gestión del ciclo de vida completo del proyecto: desde el análisis funcional
                hasta el despliegue y soporte post-implantación.
              </li>
              <li>
                Obtención de la certificación <strong>Microsoft Certified: Power Platform App Maker
                Associate (PL-100)</strong> durante este periodo.
              </li>
            </ul>
            <div class="flex flex-wrap gap-2 pt-1">
              {[
                "Power Apps", "Power Automate", "SharePoint Online",
                "Microsoft Forms", "Power Platform",
              ].map((skill) => (
                <span class="rounded-full border border-black/15 px-2 py-0.5 text-xs dark:border-white/20">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <hr class="border-black/10 dark:border-white/10" />

          <!-- EFOR -->
          <div class="space-y-2">
            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  Desarrollador de Software — Microsoft Power Platform
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  EFOR Internet y Tecnología · Presencial · Zaragoza, España
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500 text-nowrap">
                Oct 2021 – Sep 2022
              </span>
            </div>
            <ul class="space-y-1 text-sm list-disc list-outside ml-4">
              <li>
                Desarrollo, implantación y mantenimiento de soluciones low-code para digitalizar
                y optimizar procesos de negocio.
              </li>
              <li>
                Creación de aplicaciones canvas personalizadas con Power Apps y arquitectura
                de datos en Dataverse (incluyendo Dataverse for Teams).
              </li>
              <li>
                Diseño de automatizaciones de flujos de trabajo integrando Power Automate
                con entornos SharePoint Online.
              </li>
              <li>
                Toma de requisitos, análisis funcional, pruebas UAT y soporte técnico
                post-despliegue.
              </li>
            </ul>
            <div class="flex flex-wrap gap-2 pt-1">
              {[
                "Power Apps", "Power Automate", "Dataverse",
                "SharePoint Online", "Low-Code",
              ].map((skill) => (
                <span class="rounded-full border border-black/15 px-2 py-0.5 text-xs dark:border-white/20">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <hr class="border-black/10 dark:border-white/10" />

          <!-- Grupo Oesía -->
          <div class="space-y-2">
            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  Desarrollador Web Junior (Prácticas)
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  Grupo Oesía · Zaragoza, España
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500 text-nowrap">
                Jul 2021 – Sep 2021
              </span>
            </div>
            <ul class="space-y-1 text-sm list-disc list-outside ml-4">
              <li>
                Apoyo en el desarrollo y mantenimiento de aplicaciones web, tanto en
                frontend como en backend.
              </li>
              <li>
                Resolución de incidencias y familiarización con el ciclo de vida del software
                en un entorno corporativo.
              </li>
            </ul>
            <div class="flex flex-wrap gap-2 pt-1">
              {["Java", "Angular", "Desarrollo Web"].map((skill) => (
                <span class="rounded-full border border-black/15 px-2 py-0.5 text-xs dark:border-white/20">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <hr class="border-black/10 dark:border-white/10" />

          <!-- Experiencia previa -->
          <div class="space-y-2">
            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  RRHH, Administración y Operaciones
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  Varias empresas · Zaragoza, España
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500 text-nowrap">
                2014 – 2019
              </span>
            </div>
            <p class="text-sm">
              Antes de incorporarme al sector IT, trabajé en roles de RRHH, documentación legal
              y operaciones — gestionando nóminas, contratos laborales, cumplimiento de protección
              de datos y procesos con clientes. Esta trayectoria me dio una visión sólida de cómo
              funcionan las organizaciones desde dentro, y ha moldeado mi enfoque en la automatización
              e ingeniería de datos: centrado en resolver problemas reales de negocio, no solo técnicos.
            </p>
          </div>
        </section>

        <!-- Formación -->
        <section class="animate space-y-6">
          <h2 class="font-semibold text-black dark:text-white">{t("cv.education")}</h2>

          <div class="space-y-6">

            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  Iniciación al Desarrollo con IA
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">BIG school</p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500">2025</span>
            </div>

            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  Vueling Data University
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  C.T.A. Aragón · SQL, T-SQL, Python para Ingeniería de Datos
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500">2023</span>
            </div>

            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  Programación Web con .NET
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  Integra Technology School · C#, ASP.NET MVC, POO, Pruebas de Software
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500">2021</span>
            </div>

            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  CFGS Desarrollo de Aplicaciones Web (DAW)
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  Colegio Montessori · Java, JavaScript, PHP, HTML, CSS, SQL, Bootstrap
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500">2019 – 2021</span>
            </div>

            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  Máster en Dirección y Gestión de Recursos Humanos
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  EUDE Business School
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500">2013 – 2014</span>
            </div>

            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  Licenciatura en Ciencias del Trabajo
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  Universidad de Zaragoza
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500">2010 – 2013</span>
            </div>

            <div class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <p class="font-medium text-black dark:text-white">
                  Diplomatura en Relaciones Laborales
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  Universidad de Zaragoza
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500">2006 – 2010</span>
            </div>

          </div>
        </section>

        <!-- Certificaciones -->
        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">{t("cv.certifications")}</h2>
          <ul class="space-y-3">
            <li class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <span class="font-medium">
                  <Link
                    href="https://learn.microsoft.com/api/credentials/share/es-es/EduSaldaa-1886/A65359E036101B0F?sharingId"
                    external
                  >
                    Microsoft Certified: Power Platform App Maker Associate (PL-100)
                  </Link>
                </span>
                <p class="text-sm text-gray-500 dark:text-gray-400">Microsoft</p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500">2023</span>
            </li>
            <li class="flex flex-wrap items-start justify-between gap-y-1">
              <div>
                <span class="font-medium">
                  <Link
                    href="https://mia.aragon.es/documentos?csv=CSVKW5USLK2E81F0DIPL"
                    external
                  >
                    Vueling Data University
                  </Link>
                </span>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  CTA Aragón · SQL, T-SQL, ETL, Python para Ingeniería de Datos
                </p>
              </div>
              <span class="text-sm text-gray-400 dark:text-gray-500">2023</span>
            </li>
          </ul>
        </section>

        <!-- Idiomas -->
        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">{t("cv.languages")}</h2>
          <ul class="space-y-1 text-sm">
            <li class="flex justify-between">
              <span>{t("cv.lang.spanish")}</span>
              <span class="text-gray-500 dark:text-gray-400">{t("cv.lang.spanish.level")}</span>
            </li>
            <li class="flex justify-between">
              <span>{t("cv.lang.english")}</span>
              <span class="text-gray-500 dark:text-gray-400">{t("cv.lang.english.level")}</span>
            </li>
          </ul>
        </section>

      </div>
    </aside>
  </Container>
</Layout>